{
  "name": "@meddleware/token-issuance-template-sui",
  "version": "1.0.10",
  "private": false,
  "type": "module",
  "author": "MeddleWare <dev@meddleware.co.uk>",
  "license": "0BSD",
  "description": "Generic Sui coin template and deployment pipeline for generating immutable coin packages. Ships the Move source, generator scripts, and the text files consumed by downstream source generators.",
  "homepage": "https://github.com/meddleware-org/token-issuance-template-sui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/token-issuance-template-sui.git"
  },
  "bugs": {
    "url": "https://github.com/meddleware-org/token-issuance-template-sui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "sui move test --build-env testnet && bash scripts/build-bytecode.sh --check",
    "build:bytecode": "bash scripts/build-bytecode.sh",
    "check:bytecode": "bash scripts/build-bytecode.sh --check"
  },
  "exports": {
    "./package.json": "./package.json",
    "./bytecode/sui_token_template.mv": "./bytecode/sui_token_template.mv",
    "./bytecode/build-info.json": "./bytecode/build-info.json"
  },
  "files": [
    "Move.toml",
    "Move.lock",
    "sources/",
    "templates/",
    "scripts/",
    "docs/onchain/",
    "docs/IMPLEMENTATION_GUIDE.md",
    "docs/WALRUS.md",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    "LICENSE",
    "SECURITY.md",
    "bytecode/"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
