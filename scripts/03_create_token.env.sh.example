# 03_create_token.env.sh.example — copy and customize for your token
export TOKEN_PACKAGE_NAME="my_token"
export TOKEN_MODULE_NAME="mytoken"
export TOKEN_STRUCT_NAME="MYTOKEN"
export TOKEN_SYMBOL="myTOKEN"
export TOKEN_NAME="My Token"
export TOKEN_DESCRIPTION="A custom token on the Sui blockchain"
export TOKEN_PACKAGE_DESCRIPTION="Official MYTOKEN share token."
export TOKEN_PROJECT_NAME="My Project"
export TOKEN_DECIMALS="9"
export TOKEN_ICON_URL="https://blob-url"

# License (optional; defaults to 0BSD if unset).
#   SPDX id (e.g. 0BSD, MIT, Apache-2.0, CC0-1.0) or NONE for proprietary/all-rights-reserved.
export TOKEN_LICENSE="0BSD"
# Copyright holder written into the bundled 0BSD LICENSE (defaults to TOKEN_PROJECT_NAME, then TOKEN_NAME).
# export TOKEN_COPYRIGHT_HOLDER="Your Name or Organisation"
# Optional: supply the license text directly instead of fetching it from SPDX.
# export TOKEN_LICENSE_TEXT_FILE="/path/to/LICENSE.txt"
# Optional: human-readable name shown in the generated README License section.
# export TOKEN_LICENSE_NAME="MIT License"